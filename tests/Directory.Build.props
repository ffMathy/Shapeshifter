<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <!-- Test naming and structure conventions differ from production code. -->
    <NoWarn>$(NoWarn);CA1707;CA1001;CA2000;CA1861;CA5394;CA1307;CA1309;CA1310;CA1305;CA2201;CA1024</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
