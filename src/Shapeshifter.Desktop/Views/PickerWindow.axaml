<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shapeshifter.Desktop.ViewModels"
        xmlns:engine="using:Shapeshifter.Core.Engine"
        xmlns:local="using:Shapeshifter.Desktop"
        x:Class="Shapeshifter.Desktop.Views.PickerWindow"
        x:DataType="vm:PickerViewModel"
        Title="Shapeshifter"
        WindowDecorations="None"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Focusable="False"
        SizeToContent="Height"
        Width="938"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <!--
    The original Shapeshifter layout: the history fills the left of the window from the top-left corner of the
    screen, and the actions of the selected item float to its right, only as tall as they need to be.
  -->
  <Grid ColumnDefinitions="566,372" VerticalAlignment="Top">
    <!-- History, with the accent-coloured edge along its right side -->
    <Border Grid.Column="0" Classes="historyPane" Classes.fill="{Binding ActionsFillHeight}">
      <Panel Background="{DynamicResource WindowBackgroundBrush}">
        <ListBox x:Name="ItemList" Classes="items" Focusable="False"
                 ItemsSource="{Binding Items}"
                 SelectedIndex="{Binding SelectedIndex}"
                 MaxHeight="{Binding MaxListHeight}"
                 AutoScrollToSelectedItem="True"
                 ScrollViewer.VerticalScrollBarVisibility="Hidden">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PickerItemViewModel">
              <Grid ColumnDefinitions="110,*">
                <Border Classes="iconArea" Grid.Column="0">
                  <Panel>
                    <PathIcon Data="{Binding Icon}" Width="58" Height="58" IsVisible="{Binding !HasIconText}" />
                    <TextBlock Classes="iconText" Text="{Binding IconText}" IsVisible="{Binding HasIconText}" />
                  </Panel>
                </Border>
                <Panel Grid.Column="1" ClipToBounds="True">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}" />
                  <StackPanel Margin="20,12,18,12" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding HasNoThumbnail}">
                    <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="subtitle" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Border Classes="thumbnailCaption" IsVisible="{Binding HasThumbnail}">
                    <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                  </Border>
                </Panel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Rectangle Classes="veil" Fill="#38000000" Opacity="{Binding IsActionsPaneActive, Converter={x:Static local:OpacityConverters.FromBool}}" />
    </Panel>
    </Border>

    <!-- Actions of the selected item -->
    <Border Grid.Column="1" Classes="actionsPane" Classes.fill="{Binding ActionsFillHeight}">
      <ListBox Classes="actions" Focusable="False"
               ItemsSource="{Binding Actions}"
               SelectedIndex="{Binding SelectedActionIndex}"
               ScrollViewer.VerticalScrollBarVisibility="Hidden">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="engine:PickerActionView">
            <StackPanel Spacing="2">
              <TextBlock Classes="actionTitle" Text="{Binding Title}" />
              <TextBlock Classes="actionDescription" Text="{Binding Description}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</Window>
