<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shapeshifter.Desktop.ViewModels"
        xmlns:services="using:Shapeshifter.Desktop.Services"
        xmlns:loc="using:Shapeshifter.Core.Localization"
        xmlns:views="using:Shapeshifter.Desktop.Views"
        x:Class="Shapeshifter.Desktop.Views.PickerWindow"
        x:DataType="vm:PickerViewModel"
        Classes="picker"
        Title="Shapeshifter"
        WindowDecorations="None"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Focusable="False"
        SizeToContent="WidthAndHeight"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <!--
    The layout shared by every look; Styles/Windows.axaml, MacOS.axaml and Linux.axaml give it its material, sizes,
    colours and type through the classes used here. A panel ("chrome") with a header, the history and the actions of
    the selected item side by side (a preview of the item above its actions), and a footer with the keys. "chrome.opaque" is set when the window cannot be
    see-through (no compositor): the panel then has to fill the window, without rounded corners or a shadow.
    "chrome.empty" is set while nothing has been copied yet.

    Pressing S starts a search (issue #458): the picker takes the keyboard focus and shows the search bar below the
    header ("Border.searchBar" with "TextBox.searchBox"); "chrome.searching" is set until the picker is hidden.
  -->
  <Border x:Name="Chrome" Classes="chrome" Classes.opaque="{Binding IsOpaque}" Classes.empty="{Binding IsEmpty}" Classes.searching="{Binding IsSearching}">
    <Border Classes="surface">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto">
        <!-- Header: the app's icon and name, how many items there are, and how to paste -->
        <Border Grid.Row="0" Classes="header">
          <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
            <Image Grid.Column="0" Classes="appIcon" Source="{x:Static services:PlatformLook.ApplicationIcon}" />
            <TextBlock Grid.Column="1" Classes="headerTitle" Text="{DynamicResource PickerTitle}" />
            <Border Grid.Column="2" Classes="countPill">
              <TextBlock Classes="headerCount" Text="{Binding ItemCountText}" />
            </Border>
            <TextBlock Grid.Column="4" Classes="headerHint" Text="{Binding HeaderHint}" />
          </Grid>
        </Border>

        <!-- While searching: what the user types -->
        <Border Grid.Row="1" Classes="searchBar" IsVisible="{Binding IsSearching}">
          <Grid ColumnDefinitions="Auto,*">
            <Path Grid.Column="0" Classes="searchGlyph" Data="{x:Static services:Glyphs.Search}" Stretch="Uniform" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Classes="searchBox" Text="{Binding SearchQuery}" PlaceholderText="{x:Static loc:Strings.PickerSearchPlaceholder}" />
          </Grid>
        </Border>

        <Grid x:Name="Body" Grid.Row="2" Classes="body" ColumnDefinitions="*,Auto">
          <!-- History -->
          <Border Grid.Column="0" Classes="historyPane" Classes.inactive="{Binding IsActionsPaneActive}">
            <StackPanel>
              <!-- Nothing copied yet: explain how Shapeshifter works instead of showing an empty list (issue #144) -->
              <StackPanel Classes="emptyState" IsVisible="{Binding IsEmpty}">
                <TextBlock Classes="emptyTitle" Text="{x:Static loc:Strings.PickerNothingCopied}" />
                <TextBlock Classes="emptyText" Text="{Binding EmptyHint}" />
              </StackPanel>

              <!-- The search found nothing -->
              <StackPanel Classes="emptyState" IsVisible="{Binding HasNoMatches}">
                <TextBlock Classes="emptyTitle" Text="{x:Static loc:Strings.PickerSearchNoMatches}" />
                <TextBlock Classes="emptyText" Text="{Binding NoMatchesText}" />
              </StackPanel>

              <ListBox x:Name="ItemList" Classes="items" Focusable="False" IsVisible="{Binding HasItems}"
                       ItemsSource="{Binding Items}"
                       SelectedIndex="{Binding SelectedIndex}"
                       MaxHeight="{Binding MaxListHeight}"
                       AutoScrollToSelectedItem="True"
                       ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PickerItemViewModel">
                    <Grid Classes="row" ColumnDefinitions="Auto,Auto,*,Auto"
                          Classes.textItem="{Binding IsTextLayout}" Classes.imageItem="{Binding IsImageLayout}"
                          Classes.filesItem="{Binding IsFilesLayout}" Classes.fileItem="{Binding IsFileLayout}">
                      <!-- Marks the selected row in looks that use a pill or bar rather than a filled row -->
                      <Border Grid.Column="0" Classes="selectionMark" />

                      <!-- What kind of item it is: a thumbnail, file icons or a line icon -->
                      <Border Grid.Column="1" Classes="tile">
                        <Panel>
                          <Path Classes="glyph" Data="{Binding Glyph}" Stretch="Uniform" IsVisible="{Binding ShowsGlyph}" />
                          <Image Classes="fileIcon" Source="{Binding FileIcon}" IsVisible="{Binding HasFileIcon}" />
                          <ItemsControl Classes="filePreviews" ItemsSource="{Binding FilePreviews}" IsVisible="{Binding HasFilePreviews}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PickerFilePreviewViewModel">
                                <Panel Classes="filePreview">
                                  <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                                  <Path Data="{x:Static vm:PickerFilePreviewViewModel.FallbackGlyph}" Stretch="Uniform" IsVisible="{Binding HasNoIcon}" />
                                </Panel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border Classes="thumbnail" IsVisible="{Binding HasThumbnail}">
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          </Border>
                          <!-- A copied colour code shows its colour -->
                          <Border Classes="thumbnail colorSwatch" Background="{Binding ColorSwatch}" IsVisible="{Binding HasColorSwatch}" />
                        </Panel>
                      </Border>

                      <!-- The content and where it came from -->
                      <StackPanel Grid.Column="2" Classes="text">
                        <TextBlock Classes="title" Text="{Binding Title}" />
                        <StackPanel Classes="source" IsVisible="{Binding HasSourceText}">
                          <Image Source="{Binding SourceIcon}" IsVisible="{Binding HasSourceIcon}" />
                          <Path Data="{Binding SourceGlyph}" Stretch="Uniform" IsVisible="{Binding ShowsSourceGlyph}" />
                          <TextBlock Text="{Binding SourceText}" />
                        </StackPanel>
                      </StackPanel>

                      <!-- When it was copied, and a pin when it is pinned -->
                      <StackPanel Grid.Column="3" Classes="pinned">
                        <Path Data="{x:Static services:Glyphs.Pin}" Stretch="Uniform" IsVisible="{Binding IsPinned}" />
                        <TextBlock Text="{Binding CopiedAgo}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <!-- The selected item, previewed large, and its actions below -->
          <Border Grid.Column="1" Classes="actionsPane" Classes.inactive="{Binding IsItemsPaneActive}" IsVisible="{Binding ShowsActions}">
            <StackPanel>
              <!--
                Preview of the selected item (issue #54): a card that grows with its content up to a maximum, with a
                footer strip that names what it is. Text shows its first lines (code in a monospaced font), an image
                itself, a colour its swatch and code, a file its icon and name, and several files a list of them.
              -->
              <Border Classes="previewPane" IsVisible="{Binding ShowsPreview}">
                <Grid x:DataType="vm:PickerItemViewModel" DataContext="{Binding SelectedItem, FallbackValue={x:Null}}"
                      RowDefinitions="Auto,Auto">
                  <!--
                    A copied link to an image, or path of one (issue #21): the image fills the card, darkened towards
                    the bottom, where the link is written over it next to a text icon. The colours are the same in every
                    look, since they are drawn over a picture.
                  -->
                  <Panel Grid.Row="0" Classes="previewLinkedImage" MinHeight="168" IsVisible="{Binding ShowsLinkedImage}">
                    <Image Source="{Binding LinkedPreviewImage}" Stretch="UniformToFill" />
                    <Border>
                      <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                          <GradientStop Offset="0.3" Color="#00000000" />
                          <GradientStop Offset="1" Color="#B8000000" />
                        </LinearGradientBrush>
                      </Border.Background>
                    </Border>
                  </Panel>
                  <!-- A copied image fills the card the same way, edge to edge, with nothing written over it. -->
                  <Panel Grid.Row="0" Classes="previewLinkedImage" MinHeight="168" IsVisible="{Binding ShowsPreviewImage}">
                    <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                  </Panel>
                  <Border Grid.Row="0" Classes="previewContent">
                    <Panel>
                      <TextBlock Classes="previewText" Classes.code="{Binding IsCodeLike}"
                                 Text="{Binding PreviewText}" IsVisible="{Binding ShowsPlainPreviewText}" />

                      <Grid Classes="previewLink" ColumnDefinitions="Auto,*" VerticalAlignment="Bottom" IsVisible="{Binding ShowsLinkedImage}">
                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#40FFFFFF"
                                BorderBrush="#59FFFFFF" BorderThickness="1" VerticalAlignment="Bottom">
                          <Path Data="{x:Static vm:PickerItemViewModel.TextGlyph}" Stretch="Uniform" Height="17"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                        </Border>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding PreviewText}"
                                   FontSize="13" Foreground="White" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                      </Grid>

                      <Grid Classes="previewColor" ColumnDefinitions="Auto,*" IsVisible="{Binding HasColorSwatch}">
                        <Border Grid.Column="0" Classes="previewSwatch" Background="{Binding ColorSwatch}" />
                        <TextBlock Grid.Column="1" Classes="previewColorCode" Text="{Binding ColorHex}" />
                      </Grid>

                      <Grid Classes="previewFile" ColumnDefinitions="Auto,*" IsVisible="{Binding IsFileLayout}">
                        <Panel Grid.Column="0" Classes="previewFileIcon">
                          <Image Source="{Binding FileIcon}" IsVisible="{Binding HasFileIcon}" />
                          <Path Data="{Binding Glyph}" Stretch="Uniform" IsVisible="{Binding !HasFileIcon}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Classes="previewFileName" Text="{Binding PreviewFileName}" />
                      </Grid>

                      <StackPanel Classes="previewFiles" IsVisible="{Binding IsFilesLayout}">
                        <ItemsControl ItemsSource="{Binding PreviewFiles}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PickerPreviewFileViewModel">
                              <Grid Classes="previewFileRow" ColumnDefinitions="Auto,*">
                                <Panel Grid.Column="0" Classes="previewFileRowIcon">
                                  <Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" />
                                  <Path Data="{Binding FallbackGlyph}" Stretch="Uniform" IsVisible="{Binding HasNoIcon}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="previewMoreFiles" Text="{Binding MorePreviewFiles}" IsVisible="{Binding HasMorePreviewFiles}" />
                      </StackPanel>

                      <Path Classes="previewGlyph" Data="{Binding Glyph}" Stretch="Uniform" IsVisible="{Binding ShowsPreviewGlyph}" />
                    </Panel>
                  </Border>
                  <Border Grid.Row="1" Classes="previewFooter">
                    <Grid ColumnDefinitions="Auto,*">
                      <Path Grid.Column="0" Classes="previewFooterGlyph" Data="{Binding PreviewCaptionGlyph}" Stretch="Uniform" />
                      <TextBlock Grid.Column="1" Classes="previewCaption" Text="{Binding PreviewCaption}" />
                    </Grid>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Classes="actionsHeader" Text="{Binding ActionsHeader}" />

              <ListBox Classes="actions" Focusable="False"
                       ItemsSource="{Binding Actions}"
                       SelectedIndex="{Binding SelectedActionIndex}"
                       ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PickerActionViewModel">
                    <Grid Classes="action" ColumnDefinitions="Auto,*,Auto">
                      <Path Grid.Column="0" Classes="actionGlyph" Data="{Binding Glyph}" Stretch="Uniform" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Classes="actionTitle" Text="{Binding Title}" />
                        <TextBlock Classes="actionDescription" Text="{Binding Description}" />
                      </StackPanel>
                      <Border Grid.Column="2" Classes="defaultBadge" IsVisible="{Binding IsDefault}">
                        <TextBlock Text="{x:Static loc:Strings.PickerDefault}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
        </Grid>

        <!-- Footer: the keys -->
        <!-- Measured no wider than the history and the actions, so the hints wrap instead of widening the picker -->
        <views:WidthFollower Grid.Row="3" Source="{Binding #Body}">
        <Border Classes="footer">
          <Panel>
          <WrapPanel Classes="hints" IsVisible="{Binding IsNotSearching}">
            <StackPanel Classes="hint" IsVisible="{Binding IsNotHeldOpen}">
              <Border Classes="key"><TextBlock Text="{Binding ModifierKey}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintRelease}" />
            </StackPanel>
            <StackPanel Classes="hint" IsVisible="{Binding IsHeldOpen}">
              <Border Classes="key"><TextBlock Text="{x:Static loc:Strings.KeyEnter}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintPaste}" />
            </StackPanel>
            <StackPanel Classes="hint" IsVisible="{Binding IsNotHeldOpen}">
              <Border Classes="key"><TextBlock Text="{x:Static loc:Strings.KeySpace}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintKeepOpen}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="V" /></Border>
              <Border Classes="key"><TextBlock Text="↑↓" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintMove}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="1–9" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintJump}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="←→" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerActions}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="S" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintSearch}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="{x:Static loc:Strings.KeyDelete}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintRemove}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="{x:Static loc:Strings.KeyEscape}" /></Border>
              <TextBlock Text="{Binding EscapeHint}" />
            </StackPanel>
          </WrapPanel>

          <!-- While searching, the picker has the keyboard focus -->
          <WrapPanel Classes="hints" IsVisible="{Binding IsSearching}">
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="{x:Static loc:Strings.KeyEnter}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintPaste}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="↑↓" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintMove}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="←→" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerActions}" />
            </StackPanel>
            <StackPanel Classes="hint">
              <Border Classes="key"><TextBlock Text="{x:Static loc:Strings.KeyEscape}" /></Border>
              <TextBlock Text="{x:Static loc:Strings.PickerHintCancel}" />
            </StackPanel>
          </WrapPanel>
          </Panel>
        </Border>
        </views:WidthFollower>
      </Grid>
    </Border>
  </Border>
</Window>
