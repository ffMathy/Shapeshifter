<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:Shapeshifter.Desktop.Services"
        x:Class="Shapeshifter.Desktop.Views.ToastWindow"
        Classes="toast"
        Title="Shapeshifter"
        WindowDecorations="None"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        CanResize="False"
        Focusable="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <!-- The "copied" notification; Styles/<Look>.axaml styles it as the platform's own notifications look. -->
  <Border x:Name="Chrome" Classes="toastChrome">
    <Grid Classes="toastBody" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
      <Image Grid.Row="0" Grid.Column="0" Classes="toastIcon" Source="{x:Static services:PlatformLook.ApplicationIcon}" />
      <TextBlock Grid.Row="0" Grid.Column="1" Classes="toastApp" Text="Shapeshifter" />
      <TextBlock x:Name="CountText" Grid.Row="1" Grid.Column="1" Classes="toastTitle" />
      <TextBlock x:Name="PreviewText" Grid.Row="2" Grid.Column="1" Classes="toastPreview" />
    </Grid>
  </Border>
</Window>
