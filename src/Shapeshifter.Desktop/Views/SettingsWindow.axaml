<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shapeshifter.Desktop.ViewModels"
        x:Class="Shapeshifter.Desktop.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Shapeshifter settings"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="avares://Shapeshifter/Assets/Application.png">
  <StackPanel Margin="24" Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image Source="avares://Shapeshifter/Assets/Application.png" Width="40" Height="40" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Shapeshifter" FontSize="20" FontWeight="Light" />
        <TextBlock Text="{Binding Version}" FontSize="11" Opacity="0.6" />
      </StackPanel>
    </StackPanel>

    <TextBlock Text="{Binding Usage}" TextWrapping="Wrap" FontSize="12" Opacity="0.8" />

    <Border IsVisible="{Binding HasWarnings}" Background="#FFF4CE" BorderBrush="#E0C060" BorderThickness="1" CornerRadius="4" Padding="10">
      <TextBlock Text="{Binding Warnings}" TextWrapping="Wrap" FontSize="12" />
    </Border>

    <StackPanel Spacing="6">
      <TextBlock Text="Delay before the history appears (milliseconds)" />
      <Grid ColumnDefinitions="*,120" ColumnSpacing="12">
        <Slider Minimum="0" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" SmallChange="100" LargeChange="500"
                Value="{Binding PasteDelayMilliseconds}" />
        <NumericUpDown Grid.Column="1" Minimum="0" Maximum="3000" Increment="100" FormatString="0"
                       Value="{Binding PasteDelayMilliseconds}" />
      </Grid>
    </StackPanel>

    <StackPanel Spacing="6">
      <TextBlock Text="Number of items to remember (pinned items are kept in addition)" />
      <NumericUpDown Minimum="1" Maximum="1000" Increment="10" FormatString="0" Width="120" HorizontalAlignment="Left"
                     Value="{Binding MaxHistoryItems}" />
    </StackPanel>

    <CheckBox IsChecked="{Binding QuietMode}" Content="Don't show a notification after copying" />
    <CheckBox IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding IsAutostartSupported}" Content="Start Shapeshifter when I log in" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Clear history" Command="{Binding ClearHistoryCommand}" />
      <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
    </StackPanel>
  </StackPanel>
</Window>
