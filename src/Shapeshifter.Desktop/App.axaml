<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Shapeshifter.Desktop.App"
             RequestedThemeVariant="Light"
             Name="Shapeshifter">
  <Application.Styles>
    <FluentTheme />
    <!-- The look of the operating system (Styles/Windows.axaml, MacOS.axaml or Linux.axaml) is added by PlatformLook. -->
  </Application.Styles>
</Application>
