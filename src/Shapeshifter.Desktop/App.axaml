<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Shapeshifter.Desktop.App"
             Name="Shapeshifter">
  <Application.Styles>
    <FluentTheme />
    <!--
      The look of the operating system (Styles/Windows.axaml, MacOS.axaml or Linux.axaml) is added by PlatformLook, which
      also sets the theme variant: the Windows look follows the light or dark app mode of Windows, the others are light.
    -->
  </Application.Styles>
</Application>
