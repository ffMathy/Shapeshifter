<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Placeholder: the Windows look is written next. -->
  <Styles.Resources>
    <x:String x:Key="PickerTitle">Clipboard history</x:String>
    <x:Double x:Key="PickerRowHeight">58</x:Double>
    <x:String x:Key="LookDefaultAccent">#0067C0</x:String>
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
  </Styles.Resources>
  <Style Selector="Border.surface"><Setter Property="Background" Value="White" /><Setter Property="CornerRadius" Value="8" /></Style>
  <Style Selector="ListBox.items"><Setter Property="Width" Value="420" /></Style>
  <Style Selector="Border.actionsPane"><Setter Property="Width" Value="280" /></Style>
</Styles>
