<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    "Mica Sheets": the Windows 11 look (Fluent 2), in light and dark: it follows the app mode of Windows (PlatformLook).
    The picker is a flyout like the shell's own (the emoji panel, the clipboard history of Win+V): a near-opaque layer
    with an 8 px radius, a 1 px stroke and the flyout shadow, or the window itself on Acrylic (NativeMaterial). The accent
    marks only what is about to happen: a 3 × 16 pill beside the selected item of the pane that has the keyboard, and the
    icon of the chosen action. Everything else is the neutral Fluent palette, in the theme dictionaries below:

      light: text #1A1A1A, text 2 #5D5D5D, Mica #F3F3F3, layer #FFFFFF, strokes black at 6–12 %, subtle fills black
             at 2–6 %, the flyout's Acrylic tint #F9F9F9;
      dark:  text #FFFFFF, text 2 white at 78 %, Mica #202020, cards #2B2B2B (white at 5 % on Mica), strokes and subtle
             fills white at 4–12 %, the flyout's Acrylic tint #2C2C2C;

    and Segoe UI Variable (Inter where it is missing). Every colour is a DynamicResource, so a change of the app mode
    restyles open windows; the accent's text shade comes from AccentPalette, per theme.

    The settings window is the Settings app: a 28 px title and cards on Mica; the copy notification is a Windows
    notification card.
  -->
  <Styles.Resources>
    <ResourceDictionary>
      <!-- Where the copy notification appears (CopyNotifier): BottomRight, TopRight or BottomCenter. -->
      <x:String x:Key="ToastPlacement">BottomRight</x:String>
      <!-- A row is 60 high with a 2 gap below it (the presenter fits whole rows of this height). -->
      <x:Double x:Key="PickerRowHeight">62</x:Double>
      <x:String x:Key="LookDefaultAccent">#0067C0</x:String>
      <FontFamily x:Key="WindowsLookFont">Segoe UI Variable Text, Segoe UI, Inter</FontFamily>

      <!-- Only used where the operating system reports no accent colour; AccentPalette replaces them otherwise. -->
      <SolidColorBrush x:Key="AccentBrush" Color="#0067C0" />
      <Color x:Key="AccentColor">#0067C0</Color>

      <!-- "Default" rather than "Light", as in FluentTheme: any other variant falls back to light. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <!-- Fluent 2 light. -->
          <!-- Text -->
          <SolidColorBrush x:Key="MicaTextPrimaryBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="MicaTextSecondaryBrush" Color="#5D5D5D" />
          <SolidColorBrush x:Key="MicaTextBodyBrush" Color="#3B3B3B" />
          <SolidColorBrush x:Key="MicaGlyphPrimaryBrush" Color="#1A1A1A" />
          <SolidColorBrush x:Key="MicaGlyphSecondaryBrush" Color="#5D5D5D" />
          <SolidColorBrush x:Key="MicaActionGlyphBrush" Color="#3B3B3B" />
          <SolidColorBrush x:Key="MicaTextOnAccentBrush" Color="#FFFFFF" />

          <!-- Picker: the flyout (drawn; on Acrylic, its tint) and its opaque fallback -->
          <SolidColorBrush x:Key="MicaFlyoutFillBrush" Color="#F2F7F7F7" />
          <SolidColorBrush x:Key="MicaFlyoutAcrylicTintBrush" Color="#D9F9F9F9" />
          <SolidColorBrush x:Key="MicaFlyoutStrokeBrush" Color="#1A000000" />
          <SolidColorBrush x:Key="MicaOpaqueBaseBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="MicaOpaqueStrokeBrush" Color="#C4C4C4" />
          <SolidColorBrush x:Key="MicaDividerStrokeBrush" Color="#0F000000" />

          <!-- Picker: rows, tiles, actions, footer and keycaps -->
          <SolidColorBrush x:Key="MicaSubtleHoverBrush" Color="#06000000" />
          <SolidColorBrush x:Key="MicaSubtleSelectedBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="MicaSubtleSelectedInactiveBrush" Color="#08000000" />
          <SolidColorBrush x:Key="MicaTileFillBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaTileStrokeBrush" Color="#14000000" />
          <SolidColorBrush x:Key="MicaActionsPaneFillBrush" Color="#8CFFFFFF" />
          <SolidColorBrush x:Key="MicaActionsPaneOpaqueBrush" Color="#F9F9F9" />
          <SolidColorBrush x:Key="MicaActionsPaneStrokeBrush" Color="#12000000" />
          <SolidColorBrush x:Key="MicaFooterFillBrush" Color="#8CEEEEEE" />
          <SolidColorBrush x:Key="MicaFooterOpaqueBrush" Color="#EEEEEE" />
          <SolidColorBrush x:Key="MicaKeycapFillBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaKeycapStrokeBrush" Color="#29000000" />

          <!-- Settings: Mica (or its opaque fallback), cards, controls, the caution InfoBar -->
          <SolidColorBrush x:Key="MicaSettingsBackgroundBrush" Color="#F3F3F3" />
          <SolidColorBrush x:Key="MicaCardFillBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaCardOnMicaFillBrush" Color="#B3FFFFFF" />
          <SolidColorBrush x:Key="MicaCardStrokeBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="MicaControlFillBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaControlStrokeBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="MicaButtonFillBrush" Color="#FBFBFB" />
          <SolidColorBrush x:Key="MicaButtonStrokeBrush" Color="#17000000" />
          <SolidColorBrush x:Key="MicaCautionFillBrush" Color="#FFF4CE" />
          <SolidColorBrush x:Key="MicaCautionStrokeBrush" Color="#0F000000" />

          <!-- Toast: a notification card (drawn; on Acrylic, its tint) -->
          <SolidColorBrush x:Key="MicaToastFillBrush" Color="#FAFAFA" />
          <SolidColorBrush x:Key="MicaToastAcrylicTintBrush" Color="#E6FAFAFA" />
          <SolidColorBrush x:Key="MicaToastStrokeBrush" Color="#17000000" />

          <!-- Only used where the operating system reports no accent colour; AccentPalette replaces it otherwise -->
          <SolidColorBrush x:Key="AccentTextBrush" Color="#0067C0" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <!-- Fluent 2 dark: the Settings app and the shell's flyouts. -->
          <!-- Text -->
          <SolidColorBrush x:Key="MicaTextPrimaryBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaTextSecondaryBrush" Color="#C8FFFFFF" />
          <SolidColorBrush x:Key="MicaTextBodyBrush" Color="#DEFFFFFF" />
          <SolidColorBrush x:Key="MicaGlyphPrimaryBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MicaGlyphSecondaryBrush" Color="#C8FFFFFF" />
          <SolidColorBrush x:Key="MicaActionGlyphBrush" Color="#DEFFFFFF" />
          <SolidColorBrush x:Key="MicaTextOnAccentBrush" Color="#000000" />

          <!-- Picker: the flyout (drawn; on Acrylic, its tint) and its opaque fallback -->
          <SolidColorBrush x:Key="MicaFlyoutFillBrush" Color="#F22C2C2C" />
          <SolidColorBrush x:Key="MicaFlyoutAcrylicTintBrush" Color="#E62C2C2C" />
          <SolidColorBrush x:Key="MicaFlyoutStrokeBrush" Color="#1FFFFFFF" />
          <SolidColorBrush x:Key="MicaOpaqueBaseBrush" Color="#202020" />
          <SolidColorBrush x:Key="MicaOpaqueStrokeBrush" Color="#454545" />
          <SolidColorBrush x:Key="MicaDividerStrokeBrush" Color="#15FFFFFF" />

          <!-- Picker: rows, tiles, actions, footer and keycaps -->
          <SolidColorBrush x:Key="MicaSubtleHoverBrush" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="MicaSubtleSelectedBrush" Color="#15FFFFFF" />
          <SolidColorBrush x:Key="MicaSubtleSelectedInactiveBrush" Color="#0EFFFFFF" />
          <SolidColorBrush x:Key="MicaTileFillBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="MicaTileStrokeBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="MicaActionsPaneFillBrush" Color="#0AFFFFFF" />
          <SolidColorBrush x:Key="MicaActionsPaneOpaqueBrush" Color="#282828" />
          <SolidColorBrush x:Key="MicaActionsPaneStrokeBrush" Color="#15FFFFFF" />
          <SolidColorBrush x:Key="MicaFooterFillBrush" Color="#8C1C1C1C" />
          <SolidColorBrush x:Key="MicaFooterOpaqueBrush" Color="#1C1C1C" />
          <SolidColorBrush x:Key="MicaKeycapFillBrush" Color="#17FFFFFF" />
          <SolidColorBrush x:Key="MicaKeycapStrokeBrush" Color="#1FFFFFFF" />

          <!-- Settings: Mica (or its opaque fallback), cards, controls, the caution InfoBar -->
          <SolidColorBrush x:Key="MicaSettingsBackgroundBrush" Color="#202020" />
          <SolidColorBrush x:Key="MicaCardFillBrush" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="MicaCardOnMicaFillBrush" Color="#0DFFFFFF" />
          <SolidColorBrush x:Key="MicaCardStrokeBrush" Color="#19000000" />
          <SolidColorBrush x:Key="MicaControlFillBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="MicaControlStrokeBrush" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="MicaButtonFillBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="MicaButtonStrokeBrush" Color="#18FFFFFF" />
          <SolidColorBrush x:Key="MicaCautionFillBrush" Color="#433519" />
          <SolidColorBrush x:Key="MicaCautionStrokeBrush" Color="#19000000" />

          <!-- Toast: a notification card (drawn; on Acrylic, its tint) -->
          <SolidColorBrush x:Key="MicaToastFillBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="MicaToastAcrylicTintBrush" Color="#E62C2C2C" />
          <SolidColorBrush x:Key="MicaToastStrokeBrush" Color="#1FFFFFFF" />

          <!-- Only used where the operating system reports no accent colour; AccentPalette replaces it otherwise -->
          <SolidColorBrush x:Key="AccentTextBrush" Color="#5BB3FF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- ============================================================== Windows -->

  <Style Selector="Window.picker">
    <Setter Property="FontFamily" Value="{StaticResource WindowsLookFont}" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource MicaOpaqueBaseBrush}" />
    <!--
      The flyout is a near-opaque surface on a transparent window. On Windows 11 the window is the flyout instead, on
      Acrylic (NativeMaterial and the "nativeMaterial" styles below): a backdrop always fills the whole window, so a
      transparent shadow margin around the flyout would show as a square frosted box.
    -->
  </Style>
  <Style Selector="Window.settings">
    <Setter Property="FontFamily" Value="{StaticResource WindowsLookFont}" />
    <Setter Property="Background" Value="{DynamicResource MicaSettingsBackgroundBrush}" />
    <!-- Where Windows grants no transparency at all, not white (Avalonia's default) in dark. -->
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource MicaSettingsBackgroundBrush}" />
    <Setter Property="Width" Value="660" />
  </Style>
  <Style Selector="Window.toast">
    <Setter Property="FontFamily" Value="{StaticResource WindowsLookFont}" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource MicaOpaqueBaseBrush}" />
  </Style>

  <!-- ============================================================== Picker: the flyout -->

  <!-- The flyout, with room around it for its shadow (the window sizes to its content). -->
  <Style Selector="Border.chrome">
    <Setter Property="Margin" Value="32,16,32,48" />
    <Setter Property="Background" Value="{DynamicResource MicaFlyoutFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaFlyoutStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="0 16 32 0 #2E000000, 0 2 8 0 #14000000" />
  </Style>
  <!-- No compositor: the flyout fills the window, square and fully opaque. -->
  <Style Selector="Border.chrome.opaque">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="{DynamicResource MicaOpaqueBaseBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaOpaqueStrokeBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
  </Style>
  <Style Selector="Border.surface">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.chrome.opaque > Border.surface">
    <Setter Property="CornerRadius" Value="0" />
  </Style>

  <!-- Header: icon, "Clipboard history" and the count on the right. -->
  <Style Selector="Border.header">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaDividerStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Image.appIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.headerTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The count sits on the right: it spans the free column (the hint, after it, is hidden). -->
  <Style Selector="Border.countPill">
    <Setter Property="Grid.ColumnSpan" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.headerCount">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.headerHint">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- ============================================================== Picker: history -->

  <Style Selector="Border.historyPane">
    <Setter Property="Padding" Value="4,4,4,2" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="ListBox.items">
    <Setter Property="Width" Value="432" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.items > ListBoxItem">
    <Setter Property="Height" Value="60" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Only the design shows: a subtle fill on hover and on the selected row, never the theme's accent fill. -->
  <Style Selector="ListBox.items > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- Hover stays below every selected fill, the lighter one of the pane without the keyboard included. -->
  <Style Selector="ListBox.items > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleHoverBrush}" />
  </Style>
  <Style Selector="ListBox.items > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleHoverBrush}" />
  </Style>
  <Style Selector="ListBox.items > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.items > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.items > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleSelectedBrush}" />
  </Style>
  <!-- While the actions have the keyboard, the chosen item keeps a lighter fill. -->
  <Style Selector="Border.historyPane.inactive ListBox.items > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleSelectedInactiveBrush}" />
  </Style>

  <Style Selector="Grid.row">
    <Setter Property="Margin" Value="0,0,12,0" />
  </Style>
  <Style Selector="Border.selectionMark">
    <Setter Property="Width" Value="3" />
    <Setter Property="Height" Value="16" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.items > ListBoxItem:selected Border.selectionMark">
    <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Border.historyPane.inactive ListBox.items > ListBoxItem:selected Border.selectionMark">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- The tile: a 40 × 40 card with a line icon, file icons or the image itself. -->
  <Style Selector="Border.tile">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="9,0,0,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource MicaTileFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaTileStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.glyph">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Image.fileIcon">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ItemsControl.filePreviews">
    <Setter Property="Margin" Value="3" />
  </Style>
  <Style Selector="Panel.filePreview">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="1" />
  </Style>
  <Style Selector="Panel.filePreview > Path">
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <!-- An image fills its tile, inside the tile's stroke. -->
  <Style Selector="Border.thumbnail">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- The content: one or two lines, and where it came from. -->
  <Style Selector="StackPanel.text">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="Spacing" Value="2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <!-- The search bar below the header while searching (issue #458) -->
  <Style Selector="Border.searchBar">
    <Setter Property="Margin" Value="12,10,12,4" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource MicaControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
  </Style>
  <!-- The accent underline of a focused Fluent text box -->
  <Style Selector="Border.searchBar:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="Path.searchGlyph">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.searchBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="White" />
  </Style>
  <Style Selector="TextBox.searchBox /template/ Border#PART_BorderElement,
                   TextBox.searchBox:pointerover /template/ Border#PART_BorderElement,
                   TextBox.searchBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Grid.row.textItem TextBlock.title">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
  </Style>
  <Style Selector="StackPanel.source">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>
  <Style Selector="StackPanel.source > Image">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.source > Path">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.source > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxWidth" Value="330" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="StackPanel.pinned">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.pinned > Path">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.pinned > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================== Picker: actions -->

  <Style Selector="Border.actionsPane">
    <Setter Property="Width" Value="300" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="{DynamicResource MicaActionsPaneFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaActionsPaneStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.chrome.opaque Border.actionsPane">
    <Setter Property="Background" Value="{DynamicResource MicaActionsPaneOpaqueBrush}" />
  </Style>
  <!-- The preview of the selected item, above its actions: a white card like the tiles. -->
  <Style Selector="Border.previewPane">
    <Setter Property="Margin" Value="8,8,8,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource MicaTileFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaTileStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- The content grows with what it shows, up to this height; the picker gets no taller than that. -->
  <Style Selector="Border.previewContent">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="MaxHeight" Value="212" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="TextBlock.previewText">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="19" />
    <Setter Property="MaxLines" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Code and commands in a monospaced font, a few more lines of it. -->
  <Style Selector="TextBlock.previewText.code">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="MaxLines" Value="10" />
  </Style>
  <Style Selector="Border.previewSwatch">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaTileStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBlock.previewColorCode">
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.previewFileIcon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.previewFileIcon > Path">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="TextBlock.previewFileName">
    <Setter Property="Margin" Value="12,0,0,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.previewFileRow">
    <Setter Property="Height" Value="26" />
  </Style>
  <Style Selector="Panel.previewFileRowIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="0,0,10,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Panel.previewFileRowIcon > Path">
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Grid.previewFileRow > TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.previewMoreFiles">
    <Setter Property="Margin" Value="28,2,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
  </Style>
  <Style Selector="Path.previewGlyph">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,12" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- The footer strip: what the item is, with a line icon, on a slightly darker band below a hairline. -->
  <Style Selector="Border.previewFooter">
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Background" Value="{DynamicResource MicaSubtleHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaDividerStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Path.previewFooterGlyph">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Stroke" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.previewCaption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.actionsHeader">
    <Setter Property="Margin" Value="12,9,12,7" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.actions">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- An action is a rounded row with room for the pill that shows the keyboard is here. -->
  <Style Selector="ListBox.actions > ListBoxItem">
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="Padding" Value="12,9,12,10" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <ContentPresenter Name="PART_ContentPresenter"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <Border Name="ActionMark" Width="3" Height="16" CornerRadius="1.5" Margin="0,11,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.actions > ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.actions > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleHoverBrush}" />
  </Style>
  <Style Selector="ListBox.actions > ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleHoverBrush}" />
  </Style>
  <!-- The chosen action keeps the history's fill whichever pane has the keyboard; the pill shows where that is. -->
  <Style Selector="ListBox.actions > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.actions > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleSelectedBrush}" />
  </Style>
  <Style Selector="ListBox.actions > ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MicaSubtleSelectedBrush}" />
  </Style>
  <!--
    With the keyboard here, the chosen action also gets the pill. Pill, toggle and focus line use the text shade of the
    accent, as Windows does in light mode: light accents (Gold #FFB900) are below 3:1 on these surfaces.
  -->
  <Style Selector="Border.actionsPane:not(.inactive) ListBox.actions > ListBoxItem:selected /template/ Border#ActionMark">
    <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <Style Selector="Path.actionGlyph">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,2,12,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Stroke" Value="{DynamicResource MicaActionGlyphBrush}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.actions > ListBoxItem:selected Path.actionGlyph">
    <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="TextBlock.actionTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="ListBox.actions > ListBoxItem:selected TextBlock.actionTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.actionDescription">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.defaultBadge">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="8,3,0,0" />
  </Style>
  <Style Selector="Border.defaultBadge > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
  </Style>

  <!-- ============================================================== Picker: footer -->

  <Style Selector="Border.footer">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="Background" Value="{DynamicResource MicaFooterFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaDividerStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.chrome.opaque Border.footer">
    <Setter Property="Background" Value="{DynamicResource MicaFooterOpaqueBrush}" />
  </Style>
  <Style Selector="WrapPanel.hints">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.hint">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
    <Setter Property="Margin" Value="0,2,18,2" />
  </Style>
  <Style Selector="StackPanel.hint > TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.key">
    <Setter Property="Padding" Value="6,1,6,1" />
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource MicaKeycapFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaKeycapStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.key > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- ============================================================== Settings: the Settings app -->

  <Style Selector="StackPanel.page">
    <Setter Property="Margin" Value="28,24,28,28" />
  </Style>
  <Style Selector="Grid.hero">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Image.heroIcon">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="0,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.heroText">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.heroTitle">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.heroVersion">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.usage">
    <Setter Property="Margin" Value="0,16,0,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextBodyBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- An InfoBar of the "caution" severity. -->
  <Style Selector="Border.warning">
    <Setter Property="Margin" Value="0,16,0,0" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource MicaCautionFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaCautionStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.warning > TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.groupHeader">
    <Setter Property="Margin" Value="1,28,0,8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
  </Style>
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource MicaCardFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaCardStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Grid.settingRow">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Margin" Value="16,11,16,11" />
  </Style>
  <Style Selector="Path.rowIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="0,0,16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="StackPanel.rowText">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.rowDescription">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.rowDivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource MicaDividerStrokeBrush}" />
  </Style>
  <Style Selector=":is(Control).rowControl">
    <Setter Property="Margin" Value="16,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Fluent number box: white field, hairline stroke, accent underline when focused. -->
  <Style Selector="NumericUpDown.rowControl">
    <Setter Property="Width" Value="140" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource MicaControlFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaControlStrokeBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <!-- Compact, borderless spin buttons inside the field, as in the NumberBox. -->
  <Style Selector="NumericUpDown.rowControl /template/ ButtonSpinner /template/ RepeatButton">
    <Setter Property="MinWidth" Value="24" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,4,2,4" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
  </Style>
  <!-- The NumberBox's small chevrons, not the theme's 16 px ones. -->
  <Style Selector="NumericUpDown.rowControl /template/ ButtonSpinner /template/ RepeatButton PathIcon">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
  </Style>
  <Style Selector="NumericUpDown.rowControl /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>

  <!-- Fluent toggle switch, in the accent. -->
  <Style Selector="ToggleSwitch.rowControl">
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="ToggleSwitch.rowControl:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.rowControl:checked:pointerover /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.rowControl:checked:pressed /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <!-- The knob on the accent: white in light, black in dark (as in WinUI; Fluent's white knob is ~2:1 on a dark-mode accent). -->
  <Style Selector="ToggleSwitch.rowControl:checked /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource MicaTextOnAccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.rowControl:checked:pointerover /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource MicaTextOnAccentBrush}" />
  </Style>
  <Style Selector="ToggleSwitch.rowControl:checked:pressed /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource MicaTextOnAccentBrush}" />
  </Style>

  <Style Selector="WrapPanel.commands">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="ItemSpacing" Value="8" />
    <Setter Property="LineSpacing" Value="8" />
    <Setter Property="Margin" Value="0,28,0,0" />
  </Style>
  <Style Selector="Button.command">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,5,12,6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource MicaButtonFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaButtonStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
  </Style>
  <Style Selector="Path.commandIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{DynamicResource MicaGlyphPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>

  <!-- ============================================================== Toast: a Windows notification -->

  <!--
    The card is 364 wide; with the room for its shadow the window, which sizes to its content, is 396. The width sits in
    the card, not on the window: a SizeToContent window measures its content unconstrained, and the preview would be
    measured as one line. It is set on the card's body (364 less padding and stroke), which the screenshot tool also
    leaves alone.
  -->
  <Style Selector="Border.toastChrome">
    <Setter Property="Margin" Value="16,8,16,24" />
    <Setter Property="Padding" Value="16,12,16,16" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource MicaToastFillBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MicaToastStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 8 16 0 #24000000" />
  </Style>
  <Style Selector="Grid.toastBody">
    <Setter Property="Width" Value="330" />
  </Style>
  <Style Selector="Image.toastIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.toastApp">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.toastTitle">
    <!-- Not indented under the app's name, as in Windows' own notifications. -->
    <Setter Property="Margin" Value="-24,14,0,2" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.toastPreview">
    <Setter Property="Margin" Value="-24,0,0,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="3" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- A tip's message reads as body text, not as quoted content. -->
  <Style Selector="Border.toastChrome.tip TextBlock.toastPreview">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="MaxLines" Value="4" />
  </Style>

  <!-- ============================================================================================================
       On the system's material (NativeMaterial, Windows 11): the window is the flyout, with Mica behind it (Acrylic
       where Mica cannot be had) and DWM's rounded corners (8, as the flyout) and shadow, so the flyout loses its margin
       and drawn shadow and lets the material through. On Mica ("mica") the panel is see-through, as Mica brings its own
       light or dark tint; on Acrylic it lays Fluent's flyout tint over the blur. Windows on Mica ("Window.mica": the
       settings window, the startup error) show it around their cards, as the Settings app does.
       ============================================================================================================ -->
  <!--
    The tint of Fluent's flyout Acrylic (about 85 % over the blur; lighter tints read grey over dark windows). Avalonia's
    Acrylic is only the blurred backdrop, so this tint is the whole colour of the material: #F9F9F9 light, #2C2C2C dark.
  -->
  <Style Selector="Border.chrome.nativeMaterial">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Background" Value="{DynamicResource MicaFlyoutAcrylicTintBrush}" />
  </Style>
  <Style Selector="Border.toastChrome.nativeMaterial">
    <Setter Property="Margin" Value="0" />
    <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
    <Setter Property="Background" Value="{DynamicResource MicaToastAcrylicTintBrush}" />
  </Style>
  <Style Selector="Border.chrome.nativeMaterial.mica, Border.toastChrome.nativeMaterial.mica">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!--
    On Mica the window lets the backdrop through (under the title bar too, with the system's Mica) and the cards are
    translucent layers on it, as in the Settings app, instead of opaque white boxes on a flat sheet. With the system's
    Mica the client area only shows it while DWM's frame stays extended over the whole window (margins of -1); Avalonia
    writes the margins again in WindowImpl.UpdateWindowProperties and WindowImpl.ExtendClientArea, so NativeMaterial
    applies the Mica again after a change of decorations, extended client area or window state.
  -->
  <Style Selector="Window.mica">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Window.settings.mica Border.group">
    <Setter Property="Background" Value="{DynamicResource MicaCardOnMicaFillBrush}" />
  </Style>

  <!-- Nothing copied yet: how to use Shapeshifter, in the history's place (the actions are hidden) -->
  <Style Selector="StackPanel.emptyState">
    <Setter Property="Width" Value="400" />
    <Setter Property="Spacing" Value="8" />
    <Setter Property="Margin" Value="16,20,16,20" />
  </Style>
  <Style Selector="StackPanel.emptyState TextBlock.emptyTitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextPrimaryBrush}" />
  </Style>
  <Style Selector="StackPanel.emptyState TextBlock.emptyText">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="Foreground" Value="{DynamicResource MicaTextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- An empty history has no count to show -->
  <Style Selector="Border.chrome.empty Border.countPill">
    <Setter Property="IsVisible" Value="False" />
  </Style>
</Styles>
