<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Shapeshifter</AssemblyName>
    <RootNamespace>Shapeshifter.Desktop</RootNamespace>
    <ApplicationIcon>Assets\Windows\Application.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <Description>Shapeshifter clipboard manager for Windows, macOS and Linux.</Description>
    <!-- Publishing: dotnet publish -c Release -r <rid> produces a single self-contained executable. -->
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <!--
    Keep the published folder down to the executable alone. Debug symbols of our own assemblies are embedded in
    them (DebugType, Directory.Build.props), so stack traces in the logs keep their line numbers; the native
    SkiaSharp/HarfBuzz symbol files that their packages ship (over 100 MB) are of no use to users.
  -->
  <Target Name="ExcludeSymbolFilesFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- The screenshot tool drives the real picker presenter and notifier in its live mode. -->
    <InternalsVisibleTo Include="Shapeshifter.ScreenshotGenerator" />
    <InternalsVisibleTo Include="Shapeshifter.Desktop.Tests" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The icon of the Linux desktop entry the installer writes, readable before Avalonia starts. -->
    <EmbeddedResource Include="Assets\Linux\Application.png" LogicalName="Shapeshifter.Application.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shapeshifter.Core\Shapeshifter.Core.csproj" />
    <ProjectReference Include="..\Shapeshifter.Platform\Shapeshifter.Platform.csproj" />
  </ItemGroup>
</Project>
