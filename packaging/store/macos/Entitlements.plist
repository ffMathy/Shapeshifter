<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the Mac App Store build. make-pkg.sh fills in __TEAM_ID__ and __BUNDLE_ID__; they must match the
  provisioning profile. The Mac App Store requires the App Sandbox.
-->
<plist version="1.0">
<dict>
  <key>com.apple.application-identifier</key>
  <string>__TEAM_ID__.__BUNDLE_ID__</string>
  <key>com.apple.developer.team-identifier</key>
  <string>__TEAM_ID__</string>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- The "Upload" actions send a clipboard item to catbox.moe. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Files the user picks in an open or save panel. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
